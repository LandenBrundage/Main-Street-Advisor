# Public browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never prefix these with NEXT_PUBLIC_
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
AI_SAFETY_IDENTIFIER_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI memory controls. These defaults keep request context compact.
AI_RECENT_MESSAGE_LIMIT=12
AI_SUMMARY_TRIGGER_MESSAGES=24
AI_SUMMARY_BATCH_SIZE=20
AI_PREVIOUS_SUMMARY_LIMIT=3
AI_MAX_OUTPUT_TOKENS=3000

# Optional centralized rebrand
NEXT_PUBLIC_PRODUCT_NAME=Main Street Advisor
NEXT_PUBLIC_PRIVACY_SUPPORT_EMAIL=mstreetadvisor@gmail.com

# Server-only test/dev switch. Requires real Supabase authentication and never runs in production.
ENABLE_AI_MOCKS=false

# Optional local demo workspace. Off by default and ignored in production.
ENABLE_DEMO_MODE=false

# Explicitly allow the local fictional-customer demo to use the real OpenAI API.
# Requires ENABLE_DEMO_MODE=true and may incur API usage charges.
ENABLE_DEMO_AI=false
